# Database
DATABASE_URL=postgresql://user:password@localhost:5432/timeflow_db

# Google OAuth (for login + Google Drive)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Google Drive (fallback for legacy refresh token)
GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# Firebase/FCM
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@project.iam.gserviceaccount.com

# Application
NODE_ENV=development
API_PORT=3000
API_HOST=localhost
API_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your-jwt-secret

# Frontend static files (PWA)
# Path to built frontend dist folder for production serving
FRONTEND_DIST_PATH=/path/to/frontend/dist

# Logging
LOG_LEVEL=info

# FCM Scheduler
FCM_SCHEDULER_ENABLED=true
FCM_REMINDER_HOUR=17
FCM_REMINDER_MINUTE=0

# Swagger / API Docs
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=12345
